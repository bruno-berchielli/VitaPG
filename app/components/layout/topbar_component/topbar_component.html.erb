<header class="flex items-center gap-3">
  <%= form_with url: search_path, method: :get, class: "min-w-0 flex-1" do |f| %>
    <label class="relative block">
      <span class="sr-only"><%= t(".search") %></span>
      <span class="pointer-events-none absolute inset-y-0 left-4 flex items-center text-text-faint">
        <%= render Ui::IconComponent.new(:search, classes: "size-4") %>
      </span>
      <%= f.search_field :q, value: query, placeholder: t(".placeholder"),
            class: "w-full rounded-full border-0 bg-surface py-2.5 pl-11 pr-4 text-sm shadow-soft placeholder:text-text-faint focus:ring-2 focus:ring-ink" %>
    </label>
  <% end %>

  <div class="relative shrink-0" <%= data_stimulus_controller.html_safe %> data-action="keydown.esc-><%= stimulus_controller %>#hide click@window-><%= stimulus_controller %>#hideOnOutsideClick">
    <button type="button" data-action="<%= stimulus_controller %>#toggle" aria-label="<%= t(".notifications") %>"
            class="relative flex size-10 cursor-pointer items-center justify-center rounded-full bg-surface text-text-muted shadow-soft transition-colors hover:text-text-main">
      <%= render Ui::IconComponent.new(:bell, classes: "size-[18px]") %>
      <% if attention? %>
        <span class="absolute right-2 top-2 size-2 rounded-full bg-danger-strong ring-2 ring-surface"></span>
      <% end %>
    </button>

    <div hidden data-<%= stimulus_controller %>-target="panel"
         class="absolute right-0 z-40 mt-3 w-96 overflow-hidden rounded-card bg-surface shadow-pop">
      <div class="flex items-center justify-between px-5 pt-4">
        <h2 class="font-display text-base font-semibold"><%= t(".notifications") %></h2>
        <%= link_to t(".view_all"), backup_runs_path, class: "text-xs font-semibold text-text-muted transition-colors hover:text-text-main" %>
      </div>
      <% if recent_events.any? %>
        <ul class="mt-2 max-h-96 overflow-y-auto pb-2">
          <% recent_events.each do |run| %>
            <li>
              <%= link_to backup_run_path(run), class: "flex items-start gap-3 px-5 py-3 transition-colors hover:bg-surface-highlight" do %>
                <span class="mt-0.5 flex size-9 shrink-0 items-center justify-center rounded-xl <%= run.completed? ? 'bg-success-subtle text-success' : 'bg-danger-subtle text-danger' %>">
                  <%= render Ui::IconComponent.new(run.completed? ? :check_circle : :x_circle, classes: "size-4.5") %>
                </span>
                <span class="min-w-0">
                  <span class="block truncate text-sm font-semibold"><%= run.backup_routine.name %></span>
                  <span class="block text-xs text-text-muted">
                    <%= run.completed? ? t(".completed", size: helpers.human_size(run.size_bytes)) : t(".failed") %>
                  </span>
                  <span class="mt-0.5 block text-[0.6875rem] text-text-faint"><%= helpers.relative_time(run.finished_at) %></span>
                </span>
              <% end %>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p class="px-5 pb-5 pt-3 text-sm text-text-muted"><%= t(".empty") %></p>
      <% end %>
    </div>
  </div>
</header>
