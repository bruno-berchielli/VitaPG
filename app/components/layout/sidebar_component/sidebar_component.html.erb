<aside class="sticky top-4 flex h-[calc(100vh-2rem)] w-64 shrink-0 flex-col rounded-card bg-surface shadow-soft">
  <div class="px-5 pt-6" <%= data_stimulus_controller.html_safe %> data-action="keydown.esc-><%= stimulus_controller %>#hide click@window-><%= stimulus_controller %>#hideOnOutsideClick">
    <%= link_to root_path, class: "flex items-center gap-2.5" do %>
      <span class="flex size-8 items-center justify-center rounded-full bg-ink">
        <span class="size-3 rounded-full bg-on-ink"></span>
      </span>
      <span class="font-display text-lg font-bold tracking-tight">VitaPG</span>
    <% end %>

    <div class="relative mt-5">
    <button type="button" class="flex w-full cursor-pointer items-center justify-between gap-2 rounded-2xl bg-surface-highlight px-3.5 py-2.5 text-left transition-colors hover:bg-border" data-action="<%= stimulus_controller %>#toggle">
      <span class="min-w-0">
        <span class="block text-[0.625rem] font-semibold uppercase tracking-[0.16em] text-text-faint"><%= t(".workspace") %></span>
        <span class="block truncate text-sm font-semibold"><%= workspace.name %></span>
      </span>
      <%= render Ui::IconComponent.new(:chevron_down, classes: "size-4 shrink-0 text-text-faint") %>
    </button>

    <div hidden data-<%= stimulus_controller %>-target="menu" class="absolute inset-x-0 top-full z-50 mt-2 space-y-0.5 rounded-2xl bg-surface p-2 shadow-pop">
      <% other_workspaces.each do |ws| %>
        <%= button_to switch_workspace_path(ws), class: "block w-full cursor-pointer rounded-xl px-3 py-2 text-left text-sm font-medium text-text-muted transition-colors hover:bg-surface-highlight hover:text-text-main" do %>
          <%= ws.name %>
        <% end %>
      <% end %>
      <%= render Ui::ModalComponent.new(title: t(".new_workspace_title")) do |modal| %>
        <% modal.with_trigger do %>
          <button type="button" class="flex w-full cursor-pointer items-center gap-2 rounded-xl px-3 py-2 text-sm font-semibold text-text-main transition-colors hover:bg-surface-highlight">
            <%= render Ui::IconComponent.new(:plus, classes: "size-4") %>
            <%= t(".new_workspace") %>
          </button>
        <% end %>
        <p class="text-sm text-text-muted"><%= t(".new_workspace_hint") %></p>
        <%= form_with url: workspaces_path, scope: :workspace, class: "mt-4 space-y-4" do |f| %>
          <%= f.labeled_text_field :name, label: t(".new_workspace_name"), placeholder: t(".new_workspace_placeholder") %>
          <%= f.submit_button t(".new_workspace_create"), class: "w-full" %>
        <% end %>
      <% end %>
    </div>
    </div>
  </div>

  <nav class="mt-6 flex-1 overflow-y-auto px-4" aria-label="<%= t(".navigation") %>">
    <p class="px-4 text-[0.625rem] font-semibold uppercase tracking-[0.16em] text-text-faint"><%= t(".sections.operations") %></p>
    <div class="mt-2 space-y-1">
      <% operations_items.each do |item| %>
        <%= link_to item.path, class: item_classes(item), aria: { current: active?(item) ? "page" : nil } do %>
          <%= render Ui::IconComponent.new(item.icon, classes: "size-[18px]") %>
          <%= t(".nav.#{item.key}") %>
        <% end %>
      <% end %>
    </div>

    <% if instance_items.any? %>
      <p class="mt-7 px-4 text-[0.625rem] font-semibold uppercase tracking-[0.16em] text-text-faint"><%= t(".sections.instance") %></p>
      <div class="mt-2 space-y-1">
        <% instance_items.each do |item| %>
          <%= link_to item.path, class: item_classes(item), aria: { current: active?(item) ? "page" : nil } do %>
            <%= render Ui::IconComponent.new(item.icon, classes: "size-[18px]") %>
            <%= t(".nav.#{item.key}") %>
          <% end %>
        <% end %>
      </div>
    <% end %>

    <p class="mt-7 px-4 text-[0.625rem] font-semibold uppercase tracking-[0.16em] text-text-faint"><%= t(".sections.workspace") %></p>
    <div class="mt-2 space-y-1">
      <% workspace_items.each do |item| %>
        <%= link_to item.path, class: item_classes(item), aria: { current: active?(item) ? "page" : nil } do %>
          <%= render Ui::IconComponent.new(item.icon, classes: "size-[18px]") %>
          <%= t(".nav.#{item.key}") %>
        <% end %>
      <% end %>
    </div>
  </nav>

  <div class="px-4 pb-5">
    <div class="flex items-center justify-center gap-1 rounded-full bg-surface-highlight p-1">
      <%= button_to appearance_profile_path(mode: "light"), method: :patch,
            class: "flex flex-1 cursor-pointer items-center justify-center gap-1.5 rounded-full px-3 py-1.5 text-xs font-semibold transition-colors #{dark_mode? ? 'text-text-faint hover:text-text-main' : 'bg-surface text-text-main shadow-soft'}" do %>
        <%= render Ui::IconComponent.new(:sun, classes: "size-3.5") %>
        <%= t(".light") %>
      <% end %>
      <%= button_to appearance_profile_path(mode: "dark"), method: :patch,
            class: "flex flex-1 cursor-pointer items-center justify-center gap-1.5 rounded-full px-3 py-1.5 text-xs font-semibold transition-colors #{dark_mode? ? 'bg-surface text-text-main shadow-soft' : 'text-text-faint hover:text-text-main'}" do %>
        <%= render Ui::IconComponent.new(:moon, classes: "size-3.5") %>
        <%= t(".dark") %>
      <% end %>
    </div>

    <div class="mt-3 flex items-center gap-2 rounded-2xl bg-surface-highlight p-2.5">
      <%= link_to profile_path, class: "flex min-w-0 flex-1 items-center gap-2.5" do %>
        <span class="flex size-9 shrink-0 items-center justify-center rounded-full bg-ink font-display text-sm font-bold text-on-ink">
          <%= user.name.first(1).upcase %>
        </span>
        <span class="min-w-0">
          <span class="block truncate text-sm font-semibold"><%= user.name %></span>
          <span class="block truncate text-xs text-text-faint"><%= user.superadmin? ? t(".superadmin") : user.email %></span>
        </span>
      <% end %>
      <%= button_to destroy_user_session_path, method: :delete, "aria-label": t(".sign_out"), title: t(".sign_out"),
            class: "cursor-pointer rounded-full p-2 text-text-faint transition-colors hover:bg-surface hover:text-danger" do %>
        <%= render Ui::IconComponent.new(:logout, classes: "size-4") %>
      <% end %>
    </div>
  </div>
</aside>
