<aside class="sticky top-0 flex h-screen w-60 shrink-0 flex-col border-r border-border bg-surface">
  <div class="border-b border-border px-4 py-4" <%= data_stimulus_controller.html_safe %>>
    <button type="button" class="flex w-full cursor-pointer items-center justify-between gap-2 rounded-md px-1.5 py-1 text-left hover:bg-surface-highlight" data-action="<%= stimulus_controller %>#toggle">
      <span class="min-w-0">
        <span class="block truncate text-sm font-semibold"><%= workspace.name %></span>
        <span class="block text-xs text-text-muted">VitaPG</span>
      </span>
      <%= render Ui::IconComponent.new(:chevron_down, classes: "size-4 shrink-0 text-text-faint") %>
    </button>

    <div hidden data-<%= stimulus_controller %>-target="menu" class="mt-2 space-y-0.5 rounded-md border border-border bg-surface p-1.5 shadow-sm">
      <% other_workspaces.each do |ws| %>
        <%= button_to switch_workspace_path(ws), class: "block w-full cursor-pointer rounded px-2 py-1.5 text-left text-sm text-text-muted hover:bg-surface-highlight hover:text-text-main" do %>
          <%= ws.name %>
        <% end %>
      <% end %>
      <%= link_to t(".new_workspace"), new_workspace_path, class: "block rounded px-2 py-1.5 text-sm text-primary hover:bg-surface-highlight" %>
    </div>
  </div>

  <nav class="flex-1 space-y-0.5 overflow-y-auto px-3 py-4" aria-label="<%= t(".navigation") %>">
    <% nav_items.each do |item| %>
      <%= link_to item.path, class: item_classes(item), aria: { current: active?(item) ? "page" : nil } do %>
        <%= render Ui::IconComponent.new(item.icon, classes: "size-[18px]") %>
        <%= t(".nav.#{item.key}") %>
      <% end %>
    <% end %>
  </nav>

  <div class="border-t border-border px-3 py-3">
    <%= link_to profile_path, class: "flex items-center gap-2.5 rounded-md px-2 py-1.5 hover:bg-surface-highlight" do %>
      <span class="flex size-7 shrink-0 items-center justify-center rounded-full bg-primary-subtle text-xs font-semibold text-primary">
        <%= user.name.first(1).upcase %>
      </span>
      <span class="min-w-0">
        <span class="block truncate text-sm font-medium"><%= user.name %></span>
        <span class="block truncate text-xs text-text-muted"><%= user.email %></span>
      </span>
    <% end %>
    <%= button_to destroy_user_session_path, method: :delete, class: "mt-1 flex w-full cursor-pointer items-center gap-2.5 rounded-md px-2 py-1.5 text-sm text-text-muted hover:bg-surface-highlight hover:text-text-main" do %>
      <%= render Ui::IconComponent.new(:logout, classes: "size-[18px]") %>
      <%= t(".sign_out") %>
    <% end %>
  </div>
</aside>
