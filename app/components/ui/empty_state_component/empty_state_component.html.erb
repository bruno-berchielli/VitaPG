<div class="flex flex-col items-center justify-center rounded-lg border border-dashed border-border-strong bg-surface px-6 py-16 text-center">
  <span class="flex size-10 items-center justify-center rounded-md bg-surface-highlight text-text-muted">
    <%= render Ui::IconComponent.new(@icon) %>
  </span>
  <h2 class="mt-4 text-sm font-semibold"><%= @title %></h2>
  <p class="mt-1 max-w-sm text-sm text-text-muted"><%= @description %></p>
  <% if action? %>
    <div class="mt-5"><%= action %></div>
  <% end %>
</div>
