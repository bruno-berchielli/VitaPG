<div class="hero-card rounded-card p-6 text-on-hero shadow-pop">
  <p class="text-[0.6875rem] font-semibold uppercase tracking-[0.18em] text-on-hero-muted"><%= @label %></p>
  <p class="mt-2 font-display text-3xl font-bold tabular-nums"><%= @value %></p>
  <% if @delta || @caption %>
    <div class="mt-3 flex items-center gap-2">
      <% if @delta %>
        <span class="rounded-md px-1.5 py-0.5 text-[0.6875rem] font-bold <%= delta_classes %>"><%= @delta %></span>
      <% end %>
      <% if @caption %>
        <span class="text-xs text-on-hero-muted"><%= @caption %></span>
      <% end %>
    </div>
  <% end %>
</div>
