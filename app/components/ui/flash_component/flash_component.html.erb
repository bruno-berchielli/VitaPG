<div class="pointer-events-none fixed inset-x-0 top-5 z-50 flex flex-col items-center gap-2 px-4" <%= data_stimulus_controller.html_safe %>>
  <% items.each do |item| %>
    <div class="pointer-events-auto flex w-auto max-w-md items-center gap-2.5 rounded-full bg-ink py-2.5 pl-4 pr-5 text-sm font-semibold text-on-ink shadow-pop" role="status">
      <span class="<%= item[:icon] == :check_circle ? 'text-success-strong' : 'text-danger-strong' %>">
        <%= render Ui::IconComponent.new(item[:icon], classes: "size-5 shrink-0") %>
      </span>
      <span><%= item[:message] %></span>
    </div>
  <% end %>
</div>
