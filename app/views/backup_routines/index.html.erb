<% content_for :title, "#{t('.title')} · VitaPG" %>

<%= render Ui::PageHeaderComponent.new(title: t(".title"), description: t(".description")) do |header| %>
  <% header.with_action do %>
    <%= render Ui::ButtonComponent.new(variant: :primary, href: new_backup_routine_path) do |b| %>
      <% b.with_leading_icon { render Ui::IconComponent.new(:plus, classes: "size-4") } %>
      <%= t(".new") %>
    <% end %>
  <% end %>
<% end %>

<div class="mt-6">
  <% if @routines.any? %>
    <div class="overflow-x-auto rounded-card bg-surface pb-2 shadow-soft">
      <table class="w-full text-left">
        <thead>
          <tr class="text-[0.6875rem] uppercase tracking-[0.14em] text-text-faint">
            <th scope="col" class="px-6 py-4 font-semibold"><%= BackupRoutine.human_attribute_name(:name) %></th>
            <th scope="col" class="px-6 py-4 font-semibold"><%= t(".database") %></th>
            <th scope="col" class="px-6 py-4 font-semibold"><%= BackupRoutine.human_attribute_name(:cron) %></th>
            <th scope="col" class="px-6 py-4 font-semibold"><%= t(".state") %></th>
            <th scope="col" class="px-6 py-4 font-semibold"><%= t(".last_run") %></th>
            <th scope="col" class="px-6 py-4 font-semibold"><%= t(".next_run") %></th>
          </tr>
        </thead>
        <tbody>
          <% @routines.each do |routine| %>
            <tr class="border-t border-border transition-colors hover:bg-surface-highlight/60">
              <td class="px-6 py-3.5 text-sm">
                <%= link_to routine.name, backup_routine_path(routine), class: "font-medium hover:text-primary" %>
              </td>
              <td class="px-6 py-3.5 font-mono text-xs text-text-muted"><%= routine.database_connection.database_name %></td>
              <td class="px-6 py-3.5 text-sm text-text-muted">
                <%= Backups::CronHumanizer.humanize(routine.cron) || tag.span(routine.cron, class: "font-mono text-xs") %>
              </td>
              <td class="px-6 py-4"><%= render Ui::StatusBadgeComponent.new(status: routine.enabled? ? :enabled : :disabled) %></td>
              <td class="px-6 py-4">
                <% if routine.last_run %>
                  <%= render Ui::StatusBadgeComponent.new(status: routine.last_run.status) %>
                <% else %>
                  <span class="text-sm text-text-faint">—</span>
                <% end %>
              </td>
              <td class="px-6 py-3.5 text-sm text-text-muted">
                <%= routine.enabled? && routine.next_run_at ? relative_time_future(routine.next_run_at) : "—" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <%= render Ui::EmptyStateComponent.new(icon: :archive, title: t(".empty.title"), description: t(".empty.description")) do |empty| %>
      <% empty.with_action do %>
        <%= render Ui::ButtonComponent.new(variant: :primary, href: new_backup_routine_path) do %><%= t(".new") %><% end %>
      <% end %>
    <% end %>
  <% end %>
</div>
