<% content_for :title, "#{t('.title')} · VitaPG" %>

<%= render Ui::PageHeaderComponent.new(title: t(".title"), description: t(".description")) do |header| %>
  <% header.with_action do %>
    <%= render Ui::ButtonComponent.new(variant: :primary, href: new_database_connection_path) do |b| %>
      <% b.with_leading_icon { render Ui::IconComponent.new(:plus, classes: "size-4") } %>
      <%= t(".new") %>
    <% end %>
  <% end %>
<% end %>

<div class="mt-6">
  <% if @connections.any? %>
    <div class="overflow-x-auto rounded-card bg-surface pb-2 shadow-soft">
      <table class="w-full text-left">
        <thead>
          <tr class="text-[0.6875rem] uppercase tracking-[0.14em] text-text-faint">
            <th scope="col" class="px-6 py-4 font-semibold"><%= DatabaseConnection.human_attribute_name(:name) %></th>
            <th scope="col" class="px-6 py-4 font-semibold"><%= DatabaseConnection.human_attribute_name(:host) %></th>
            <th scope="col" class="px-6 py-4 font-semibold"><%= DatabaseConnection.human_attribute_name(:database_name) %></th>
            <th scope="col" class="px-6 py-4 font-semibold"><%= DatabaseConnection.human_attribute_name(:sslmode) %></th>
            <th scope="col" class="px-6 py-4 font-semibold"><%= t(".routines") %></th>
            <th scope="col" class="px-6 py-4"><span class="sr-only"><%= t(".actions") %></span></th>
          </tr>
        </thead>
        <tbody>
          <% @connections.each do |connection| %>
            <tr class="border-t border-border transition-colors hover:bg-surface-highlight/60">
              <td class="px-6 py-3.5 text-sm font-medium"><%= connection.name %></td>
              <td class="px-6 py-3.5 font-mono text-xs text-text-muted"><%= connection.host %>:<%= connection.port %></td>
              <td class="px-6 py-3.5 font-mono text-xs text-text-muted"><%= connection.database_name %></td>
              <td class="px-6 py-3.5 font-mono text-xs text-text-muted"><%= connection.sslmode_before_type_cast %></td>
              <td class="px-6 py-3.5 text-sm tabular-nums text-text-muted"><%= connection.backup_routines.size %></td>
              <td class="px-6 py-3.5 text-right">
                <div class="inline-flex items-center gap-1">
                  <%= button_to test_database_connection_path(connection), class: "cursor-pointer rounded-full border border-border-strong px-3.5 py-1.5 text-xs font-semibold text-text-muted transition-colors hover:bg-surface-highlight hover:text-text-main" do %>
                    <%= t("actions.test") %>
                  <% end %>
                  <%= link_to t("actions.edit"), edit_database_connection_path(connection), class: "rounded-full bg-ink px-3.5 py-1.5 text-xs font-semibold text-on-ink transition-opacity hover:opacity-85" %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <%= render Ui::EmptyStateComponent.new(icon: :database, title: t(".empty.title"), description: t(".empty.description")) do |empty| %>
      <% empty.with_action do %>
        <%= render Ui::ButtonComponent.new(variant: :primary, href: new_database_connection_path) do %><%= t(".new") %><% end %>
      <% end %>
    <% end %>
  <% end %>
</div>
