<% content_for :title, "#{t('.title')} · VitaPG" %>

<div class="flex min-h-screen items-center justify-center px-4 py-12">
  <div class="w-full max-w-sm">
    <div class="mb-6 text-center">
      <span class="inline-flex items-center gap-2.5">
        <span class="flex size-8 items-center justify-center rounded-full bg-ink"><span class="size-3 rounded-full bg-on-ink"></span></span>
        <span class="font-display text-xl font-bold tracking-tight">VitaPG</span>
      </span>
      <p class="mt-2 text-sm text-text-muted"><%= t(".tagline") %></p>
    </div>

    <div class="rounded-card bg-surface p-8 shadow-pop">
      <h1 class="font-display text-lg font-bold"><%= t(".title") %></h1>
      <p class="mt-1.5 text-sm text-text-muted"><%= t(".hint") %></p>

      <%= form_with url: user_session_path, class: "mt-5 space-y-4" do |f| %>
        <div class="space-y-1.5">
          <%= f.label :email, t(".email"), class: "block text-sm font-semibold" %>
          <%= f.email_field :email, autofocus: true, required: true, autocomplete: "email", placeholder: "you@company.com",
                class: "block w-full rounded-xl border-0 bg-surface-highlight px-4 py-2.5 text-sm placeholder:text-text-faint focus:bg-surface focus:ring-2 focus:ring-ink" %>
        </div>
        <%= f.submit t(".send_link"), class: "w-full cursor-pointer rounded-full bg-ink px-5 py-2.5 text-sm font-semibold text-on-ink transition-opacity hover:opacity-85" %>
      <% end %>

      <% if User.google_auth_configured? %>
        <div class="mt-5 flex items-center gap-3 text-xs text-text-faint">
          <span class="h-px flex-1 bg-border"></span>
          <%= t(".or") %>
          <span class="h-px flex-1 bg-border"></span>
        </div>
        <div class="mt-5">
          <%= button_to user_google_oauth2_omniauth_authorize_path, data: { turbo: false },
                class: "flex w-full cursor-pointer items-center justify-center gap-2 rounded-full border border-border-strong bg-surface px-5 py-2.5 text-sm font-semibold transition-colors hover:bg-surface-highlight" do %>
            <svg class="size-4" viewBox="0 0 24 24"><path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 0 1-2.2 3.32v2.77h3.57c2.08-1.92 3.27-4.74 3.27-8.1z"/><path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84A11 11 0 0 0 12 23z"/><path fill="#FBBC05" d="M5.84 14.1a6.6 6.6 0 0 1 0-4.2V7.06H2.18a11 11 0 0 0 0 9.88l3.66-2.84z"/><path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15A11 11 0 0 0 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"/></svg>
            <%= t(".google") %>
          <% end %>
        </div>
      <% end %>
    </div>

    <p class="mt-4 text-center text-xs text-text-faint"><%= t(".internal_note") %></p>

    <div class="mt-4 flex justify-center gap-3 text-xs text-text-faint">
      <% { "en" => "EN", "pt-BR" => "PT", "es" => "ES" }.each do |code, label| %>
        <%= button_to label, locale_path(locale: code), method: :patch,
              class: "cursor-pointer #{I18n.locale.to_s == code ? 'font-semibold text-text-muted' : 'hover:text-text-muted'}" %>
      <% end %>
    </div>
  </div>
</div>
