<!DOCTYPE html>
<html lang="<%= I18n.locale %>" data-mode="<%= current_mode %>">
  <head>
    <title><%= content_for(:title) || "VitaPG" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", type: "module" %>
  </head>

  <body>
    <%= render Ui::FlashComponent.new(flash: flash) %>

    <% if user_signed_in? && current_workspace %>
      <div class="flex min-h-screen">
        <%= render Layout::SidebarComponent.new %>
        <main class="min-w-0 flex-1 px-8 py-8">
          <div class="mx-auto max-w-6xl">
            <%= yield %>
          </div>
        </main>
      </div>
    <% else %>
      <main class="min-h-screen"><%= yield %></main>
    <% end %>
  </body>
</html>
