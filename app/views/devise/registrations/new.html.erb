<% content_for :title, "#{t('.sign_up')} · VitaPG" %>

<%= render layout: "devise/shared/auth_card", locals: { heading: t(".sign_up") } do %>
  <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: "space-y-4" }) do |f| %>
    <%= f.labeled_text_field :name, autofocus: true %>
    <%= f.labeled_email_field :email, autocomplete: "email" %>
    <%= f.labeled_password_field :password, autocomplete: "new-password",
          hint: (t("devise.shared.minimum_password_length", count: @minimum_password_length) if @minimum_password_length) %>
    <%= f.labeled_password_field :password_confirmation, autocomplete: "new-password" %>

    <%= f.submit_button t("devise.registrations.new.sign_up"), class: "w-full" %>
  <% end %>
<% end %>
