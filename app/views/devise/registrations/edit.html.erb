<% content_for :title, "#{t('.title')} · VitaPG" %>

<div class="mx-auto max-w-xl">
  <%= render Ui::PageHeaderComponent.new(title: t(".title", resource: resource.model_name.human), description: resource.email) %>

  <div class="mt-6">
    <%= render Ui::CardComponent.new do %>
      <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put, class: "space-y-4" }) do |f| %>
        <%= f.labeled_email_field :email, autocomplete: "email" %>
        <%= f.labeled_password_field :password, autocomplete: "new-password", hint: t(".leave_blank_if_you_don_t_want_to_change_it") %>
        <%= f.labeled_password_field :password_confirmation, autocomplete: "new-password" %>
        <%= f.labeled_password_field :current_password, autocomplete: "current-password", hint: t(".we_need_your_current_password_to_confirm_your_changes") %>
        <div class="flex items-center gap-2 border-t border-border pt-4">
          <%= f.submit_button t(".update") %>
          <%= render Ui::ButtonComponent.new(variant: :ghost, href: profile_path) do %><%= t("actions.cancel") %><% end %>
        </div>
      <% end %>
    <% end %>
  </div>
</div>
