<% content_for :title, "#{t('.sign_in')} · VitaPG" %>

<%= render layout: "devise/shared/auth_card", locals: { heading: t(".sign_in") } do %>
  <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "space-y-4" }) do |f| %>
    <%= f.labeled_email_field :email, autofocus: true, autocomplete: "email" %>
    <%= f.labeled_password_field :password, autocomplete: "current-password" %>

    <% if devise_mapping.rememberable? %>
      <%= f.labeled_check_box :remember_me, label: t("activerecord.attributes.user.remember_me") %>
    <% end %>

    <%= f.submit_button t("devise.sessions.new.sign_in"), class: "w-full" %>
  <% end %>
<% end %>
