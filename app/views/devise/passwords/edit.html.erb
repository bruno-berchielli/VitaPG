<% content_for :title, "#{t('.change_your_password')} · VitaPG" %>

<%= render layout: "devise/shared/auth_card", locals: { heading: t(".change_your_password") } do %>
  <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put, class: "space-y-4" }) do |f| %>
    <%= f.hidden_field :reset_password_token %>
    <%= f.labeled_password_field :password, label: t("devise.passwords.edit.new_password"), autofocus: true, autocomplete: "new-password",
          hint: (t("devise.shared.minimum_password_length", count: @minimum_password_length) if @minimum_password_length) %>
    <%= f.labeled_password_field :password_confirmation, label: t("devise.passwords.edit.confirm_new_password"), autocomplete: "new-password" %>
    <%= f.submit_button t("devise.passwords.edit.change_my_password"), class: "w-full" %>
  <% end %>
<% end %>
