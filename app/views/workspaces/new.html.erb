<div class="mx-auto mt-24 w-full max-w-md rounded-card bg-surface shadow-soft p-8">
  <h1 class="text-lg font-semibold"><%= t(".title") %></h1>
  <p class="mt-1 text-sm text-text-muted"><%= t(".subtitle") %></p>

  <%= form_with model: @workspace, class: "mt-6 space-y-4" do |f| %>
    <% if @workspace.errors.any? %>
      <div class="rounded-md bg-danger-subtle p-3 text-sm text-danger"><%= @workspace.errors.full_messages.to_sentence %></div>
    <% end %>
    <div>
      <%= f.label :name, t(".name"), class: "block text-sm font-medium" %>
      <%= f.text_field :name, autofocus: true, class: "mt-1.5 w-full rounded-xl border-0 bg-surface-highlight px-4 py-2.5 text-sm placeholder:text-text-faint focus:bg-surface focus:ring-2 focus:ring-ink" %>
    </div>
    <%= f.submit t(".create"), class: "w-full cursor-pointer rounded-full bg-ink px-5 py-2.5 text-sm font-semibold text-on-ink transition-opacity hover:opacity-85" %>
  <% end %>
</div>
