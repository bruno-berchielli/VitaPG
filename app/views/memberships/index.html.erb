<% content_for :title, "#{t('.title')} · VitaPG" %>

<%= render Ui::PageHeaderComponent.new(title: t(".title"), description: t(".description", workspace: current_workspace.name)) %>

<div class="mt-6 grid gap-6 lg:grid-cols-3">
  <div class="lg:col-span-2">
    <div class="overflow-x-auto rounded-card bg-surface pb-2 shadow-soft">
      <table class="w-full text-left">
        <thead>
          <tr class="text-[0.6875rem] uppercase tracking-[0.14em] text-text-faint">
            <th scope="col" class="px-6 py-4 font-semibold"><%= t(".table.member") %></th>
            <th scope="col" class="px-6 py-4 font-semibold"><span class="inline-flex items-center gap-1.5"><%= t(".table.role") %> <%= render Ui::InfoTipComponent.new(text: t(".table.role_tip")) %></span></th>
            <th scope="col" class="px-6 py-4"><span class="sr-only"><%= t(".table.actions") %></span></th>
          </tr>
        </thead>
        <tbody>
          <% @memberships.each do |membership| %>
            <tr class="border-t border-border">
              <td class="px-6 py-4">
                <span class="flex items-center gap-3">
                  <span class="flex size-10 shrink-0 items-center justify-center rounded-full bg-ink font-display text-sm font-bold text-on-ink"><%= membership.user.name.first(1).upcase %></span>
                  <span class="min-w-0">
                    <span class="block truncate text-sm font-semibold"><%= membership.user.name %><%= " (#{t('.you')})" if membership.user == current_user %></span>
                    <span class="block truncate text-xs text-text-muted"><%= membership.user.email %></span>
                  </span>
                </span>
              </td>
              <td class="px-6 py-4">
                <% if workspace_manager? && membership.user != current_user %>
                  <%= form_with model: membership, url: membership_path(membership), method: :patch, class: "inline-block" do |f| %>
                    <%= f.select :role, Membership.roles.keys.map { |r| [t("memberships.roles.#{r}"), r] }, {},
                          class: "rounded-full border-0 bg-surface-highlight py-1.5 pl-3.5 pr-9 text-sm font-medium focus:ring-2 focus:ring-ink",
                          onchange: "this.form.requestSubmit()" %>
                  <% end %>
                <% else %>
                  <span class="text-sm text-text-muted"><%= t("memberships.roles.#{membership.role}") %></span>
                <% end %>
              </td>
              <td class="px-6 py-3.5 text-right">
                <% if workspace_manager? && membership.user != current_user %>
                  <%= button_to membership_path(membership), method: :delete,
                        data: { turbo_confirm: t("confirmations.remove_member", name: membership.user.name) },
                        class: "cursor-pointer rounded-full px-3.5 py-1.5 text-xs font-semibold text-danger transition-colors hover:bg-danger-subtle" do %>
                    <%= t(".remove") %>
                  <% end %>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>

  <% if workspace_manager? %>
    <div class="space-y-6">
      <% if @join_requests&.any? %>
        <%= render Ui::CardComponent.new do %>
          <h2 class="font-display text-base font-semibold"><%= t(".requests.title") %></h2>
          <p class="mt-1 text-xs text-text-muted"><%= t(".requests.description") %></p>
          <ul class="mt-4 space-y-3">
            <% @join_requests.each do |request| %>
              <li class="flex items-center justify-between gap-3">
                <span class="min-w-0">
                  <span class="block truncate text-sm font-semibold"><%= request.user.name %></span>
                  <span class="block truncate text-xs text-text-muted"><%= request.user.email %></span>
                </span>
                <span class="flex shrink-0 gap-1.5">
                  <%= button_to t(".requests.approve"), approve_join_request_path(request), class: "cursor-pointer rounded-full bg-success-strong px-3.5 py-1.5 text-xs font-semibold text-white transition-opacity hover:opacity-85" %>
                  <%= button_to t(".requests.deny"), deny_join_request_path(request), class: "cursor-pointer rounded-full border border-border-strong px-3.5 py-1.5 text-xs font-semibold text-text-muted transition-colors hover:bg-surface-highlight" %>
                </span>
              </li>
            <% end %>
          </ul>
        <% end %>
      <% end %>

      <%= render Ui::CardComponent.new do %>
        <h2 class="text-sm font-semibold"><%= t(".invite.title") %></h2>
        <p class="mt-1 text-xs text-text-muted"><%= t(".invite.description") %></p>
        <%= form_with url: memberships_path, scope: :membership, class: "mt-4 space-y-4" do |f| %>
          <%= f.labeled_email_field :email, label: t(".invite.email") %>
          <%= f.labeled_text_field :name, label: t(".invite.name"), hint: t(".invite.name_hint") %>
          <%= f.labeled_select :role, Membership.roles.keys.map { |r| [t("memberships.roles.#{r}"), r] }, label: t(".invite.role") %>
          <%= f.submit_button t(".invite.submit") %>
        <% end %>
      <% end %>
    </div>
  <% end %>
</div>
