<% content_for :title, "#{@user.name} · VitaPG" %>

<nav class="text-sm text-text-muted">
  <%= link_to t(".breadcrumb"), admin_users_path, class: "hover:text-text-main" %>
  <span class="mx-1 text-text-faint">/</span>
  <span><%= @user.name %></span>
</nav>

<div class="mt-4">
  <%= render Ui::PageHeaderComponent.new(title: @user.name, description: t(".description")) %>
</div>

<div class="mt-6 grid gap-6 lg:grid-cols-3">
  <div class="space-y-6 lg:col-span-2">
    <%= render Ui::CardComponent.new(padding: false) do %>
      <div class="flex flex-wrap items-center justify-between gap-3 px-6 pt-5">
        <h2 class="flex items-center gap-1.5 font-display text-base font-semibold">
          <%= t(".workspaces.title") %>
          <%= render Ui::InfoTipComponent.new(text: t(".workspaces.tip")) %>
        </h2>
        <% if @user.superadmin? %>
          <span class="inline-flex items-center gap-1.5 rounded-full bg-info-subtle px-4 py-2 text-xs font-semibold text-info">
            <%= render Ui::IconComponent.new(:bolt, classes: "size-3.5") %>
            <%= t(".workspaces.global_access") %>
            <%= render Ui::InfoTipComponent.new(text: t(".workspaces.global_access_tip")) %>
          </span>
        <% end %>
      </div>
      <% if @memberships.any? %>
        <table class="mt-2 w-full text-left <%= "pointer-events-none opacity-45 select-none" if @user.superadmin? %>" <%= "aria-disabled=true".html_safe if @user.superadmin? %>>
          <thead>
            <tr class="text-[0.6875rem] uppercase tracking-[0.14em] text-text-faint">
              <th scope="col" class="px-6 py-2 font-semibold"><%= t(".workspaces.workspace") %></th>
              <th scope="col" class="px-6 py-2 font-semibold"><%= t(".workspaces.role") %></th>
              <th scope="col" class="px-6 py-2"><span class="sr-only"><%= t(".workspaces.actions") %></span></th>
            </tr>
          </thead>
          <tbody>
            <% @memberships.each do |membership| %>
              <tr class="border-t border-border">
                <td class="px-6 py-3.5 text-sm font-semibold"><%= membership.workspace.name %></td>
                <td class="px-6 py-3.5">
                  <%= form_with model: membership, url: admin_membership_path(membership), method: :patch, class: "inline-block" do |f| %>
                    <%= f.select :role, Membership.roles.keys.map { |r| [t("memberships.roles.#{r}"), r] }, {},
                          class: "rounded-full border-0 bg-surface-highlight py-1.5 pl-3.5 pr-9 text-sm font-medium focus:ring-2 focus:ring-ink",
                          onchange: "this.form.requestSubmit()" %>
                  <% end %>
                </td>
                <td class="px-6 py-3.5 text-right">
                  <%= button_to admin_membership_path(membership), method: :delete,
                        data: { turbo_confirm: t(".workspaces.confirm_remove", name: @user.name, workspace: membership.workspace.name) },
                        class: "cursor-pointer rounded-full px-3.5 py-1.5 text-xs font-semibold text-danger transition-colors hover:bg-danger-subtle" do %>
                    <%= t(".workspaces.remove") %>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
        <div class="pb-2"></div>
      <% else %>
        <p class="px-6 pb-5 pt-3 text-sm text-text-muted"><%= t(".workspaces.none") %></p>
      <% end %>
    <% end %>

    <% if @available_workspaces.any? && !@user.superadmin? %>
      <%= render Ui::CardComponent.new do %>
        <h2 class="font-display text-base font-semibold"><%= t(".add.title") %></h2>
        <%= form_with url: admin_user_memberships_path(@user), scope: :membership, class: "mt-4 flex flex-wrap items-end gap-3" do |f| %>
          <div class="min-w-48 flex-1 space-y-1.5">
            <%= f.label :workspace_id, t(".add.workspace"), class: "block text-sm font-semibold" %>
            <%= f.select :workspace_id, @available_workspaces.pluck(:name, :id), {},
                  class: "block w-full rounded-xl border-0 bg-surface-highlight px-4 py-2.5 text-sm focus:bg-surface focus:ring-2 focus:ring-ink" %>
          </div>
          <div class="min-w-40 space-y-1.5">
            <%= f.label :role, t(".add.role"), class: "block text-sm font-semibold" %>
            <%= f.select :role, Membership.roles.keys.map { |r| [t("memberships.roles.#{r}"), r] }, {},
                  class: "block w-full rounded-xl border-0 bg-surface-highlight px-4 py-2.5 text-sm focus:bg-surface focus:ring-2 focus:ring-ink" %>
          </div>
          <%= f.submit_button t(".add.submit") %>
        <% end %>
      <% end %>
    <% end %>
  </div>

  <div class="space-y-6">
    <%= render Ui::CardComponent.new do %>
      <h2 class="font-display text-base font-semibold"><%= t(".account.title") %></h2>
      <%= form_with model: @user, url: admin_user_path(@user), method: :patch, class: "mt-4 space-y-4" do |f| %>
        <%= f.labeled_text_field :name, label: t(".account.name") %>
        <%= f.labeled_email_field :email, label: t(".account.email") %>
        <%= f.submit_button t("actions.save") %>
      <% end %>
    <% end %>

    <%= render Ui::CardComponent.new do %>
      <h2 class="font-display text-base font-semibold"><%= t(".access.title") %></h2>
      <p class="mt-1 text-xs text-text-muted"><%= t(".access.hint") %></p>
      <div class="mt-4 flex items-center justify-between gap-3">
        <% if @user.superadmin? %>
          <span class="inline-flex items-center rounded-lg bg-ink px-2.5 py-1 text-xs font-semibold text-on-ink"><%= t("admin.users.index.superadmin") %></span>
        <% else %>
          <span class="text-sm text-text-muted"><%= t("admin.users.index.regular") %></span>
        <% end %>
        <% if @user != current_user %>
          <%= button_to toggle_superadmin_admin_user_path(@user), method: :patch,
                data: (@user.superadmin? ? {} : { turbo_confirm: t("admin.users.index.confirm_promote", name: @user.name) }),
                class: "cursor-pointer rounded-full border border-border-strong px-3.5 py-1.5 text-xs font-semibold text-text-muted transition-colors hover:bg-surface-highlight hover:text-text-main" do %>
            <%= @user.superadmin? ? t("admin.users.index.demote") : t("admin.users.index.promote") %>
          <% end %>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
