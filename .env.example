# All variables are optional for local development.

# --- Production ---
# Public hostname used in emails and generated links.
# APP_HOST=backups.example.com

# First account: created automatically at boot when set (or run
# `bin/rails vitapg:superadmin EMAIL=...`). Superadmins can access and manage
# every workspace.
# VITAPG_SUPERADMIN_EMAIL=you@company.com
# VITAPG_SUPERADMIN_NAME=Jane Doe

# Outgoing email. Required in production: sign-in links arrive by email.
# MAILER_FROM must be a sender address your provider accepts (e.g. a Postmark
# sender signature).
# MAILER_FROM=vitapg@company.com
# SMTP_ADDRESS=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_AUTHENTICATION=plain

# Google sign-in (optional). When set, a "Continue with Google" button appears.
# GOOGLE_ALLOWED_DOMAINS auto-provisions accounts for those email domains;
# leave it unset to allow Google sign-in only for existing users.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_ALLOWED_DOMAINS=company.com,subsidiary.com

# --- Backup engine ---
# Wall-clock limit for a single pg_dump (seconds). Default: 21600 (6h).
# VITAPG_DUMP_TIMEOUT_SECONDS=21600
# Free disk space (MB) kept in reserve while dumping. A run refuses to start
# when the last dump plus this reserve won't fit, and pg_dump is stopped if
# free space drops below it. Default: 1024.
# VITAPG_MIN_FREE_DISK_MB=1024

# --- Encryption (advanced) ---
# By default, credential-encryption keys derive from SECRET_KEY_BASE.
# Set these explicitly if you plan to rotate SECRET_KEY_BASE independently.
# ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=
# ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=
# ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=
